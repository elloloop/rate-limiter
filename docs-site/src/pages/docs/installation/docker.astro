---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { Code } from "astro-expressive-code/components";
---

<DocsLayout title="Docker">
  <h1>Docker</h1>
  <p>The release image is published to GitHub Container Registry.</p>

  <Code code={`docker pull ghcr.io/elloloop/rate-limiter:v0.4.8`} lang="bash" />

  <h2>Run with Redis</h2>
  <Code code={`docker network create quota || true
docker run -d --name quota-redis --network quota redis:7.4.2-alpine
docker run --rm --name quota-service --network quota \\
  -p 8080:8080 -p 9090:9090 \\
  -e QUOTA_PRODUCT=workspace \\
  -e QUOTA_ENVIRONMENT=local \\
  -e QUOTA_REDIS_URL=redis://quota-redis:6379/0 \\
  ghcr.io/elloloop/rate-limiter:v0.4.8`} lang="bash" />

  <h2>Commands</h2>
  <ul>
    <li><code>quota-service serve</code></li>
    <li><code>quota-service validate-limits /path/examples.yaml</code></li>
    <li><code>quota-service print-config</code></li>
  </ul>
</DocsLayout>
