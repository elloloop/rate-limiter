---
const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { label: "Documentation", href: "/rate-limiter/" },
      { label: "GitHub", href: "https://github.com/elloloop/rate-limiter" },
      { label: "Releases", href: "https://github.com/elloloop/rate-limiter/releases" },
    ],
  },
  {
    title: "Resources",
    links: [
      {
        label: "Container Image",
        href: "https://github.com/elloloop/rate-limiter/pkgs/container/rate-limiter",
      },
      {
        label: "Protobuf",
        href: "https://github.com/elloloop/rate-limiter/tree/main/quota/v1",
      },
      {
        label: "Redis Scripts",
        href: "https://github.com/elloloop/rate-limiter/tree/main/ratelimiterserver/backend/redis/scripts",
      },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "Issues", href: "https://github.com/elloloop/rate-limiter/issues" },
      { label: "Discussions", href: "https://github.com/elloloop/rate-limiter/discussions" },
      {
        label: "License (Apache-2.0)",
        href: "https://github.com/elloloop/rate-limiter/blob/main/LICENSE",
      },
    ],
  },
];
---

<footer
  class="mt-24 border-t border-border bg-muted/20 px-6 py-12 text-sm md:px-10"
>
  <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2 md:grid-cols-4">
    <div class="space-y-3">
      <a href="/rate-limiter/" class="flex items-center gap-2 font-bold">
        <div
          class="h-6 w-6 rounded-md bg-gradient-to-br from-primary to-primary/60"
        >
        </div>
        <span class="text-primary">Rate Limiter</span>
      </a>
      <p class="text-xs text-muted-foreground leading-relaxed">
        Generic quota and rate limiting service. Caller-owned policy,
        Redis-backed quota math, pure gRPC API.
      </p>
      <p class="text-xs text-muted-foreground">Copyright {year} Rate Limiter</p>
    </div>
    {
      columns.map((col) => (
        <div>
          <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-foreground">
            {col.title}
          </h4>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-muted-foreground transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div
    class="mx-auto mt-10 flex max-w-6xl flex-col items-center justify-between gap-4 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row"
  >
    <p>Copyright {year} Rate Limiter - Apache-2.0 License</p>
  </div>
</footer>
